# Copy to .env and fill in. Never commit .env. Every value here is read on the
# server only; nothing in this file is sent to browsers.

# ─── AssemblyAI (required for voice) ───────────────────────────────────────
# Used only by the SENTINEL server's voice relay. Browsers stream audio to
# SENTINEL and never receive this key or any AssemblyAI token.
ASSEMBLYAI_API_KEY=

# Optional: agent voice. One of: alba, eve, george, jane, jean, mary, michael,
# anna, charles, paul, vera (see AssemblyAI Voice Agent API → Voices). Default: jane
ASSEMBLYAI_VOICE=jane

# Optional: background-noise isolation (input.voice_focus). far-field suits laptop
# and room microphones (default); near-field suits headsets.
ASSEMBLYAI_VOICE_FOCUS=far-field

# Optional: override the Voice Agent WebSocket URL (tests point this at a mock).
# ASSEMBLYAI_WS_URL=wss://agents.assemblyai.com/v1/ws

# ─── Public URL & security ─────────────────────────────────────────────────
# The URL people use to reach SENTINEL. Required in production: used for CSRF
# checks, the voice WebSocket origin check, and links in notifications.
ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Encrypts transcript text and evidence quotes at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: data encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY=

# Bearer token for GET /api/metrics (Prometheus). Leave empty to disable the endpoint.
METRICS_TOKEN=

# Max request body (adapter-node). Photos are up to 5 MB.
BODY_SIZE_LIMIT=6M

# ─── Database ──────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in
# PGLITE_DATA_DIR (single instance, development). Production: set a PostgreSQL URL.
#   DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# ─── Notifications (each channel is off until configured) ──────────────────
# Twilio SMS and phone calls. Delivery receipts arrive at
# $PUBLIC_BASE_URL/api/webhooks/twilio/status (signature-verified).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email via SMTP, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Generic webhook (PagerDuty/Opsgenie bridges, etc.). If a secret is set, each request
# carries x-sentinel-signature: sha256=<HMAC of the body>.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ─── Operations ────────────────────────────────────────────────────────────
# Background jobs (escalation timers, notification outbox, reconciliation,
# retention). Several instances can run it: one is elected leader.
SCHEDULER_ENABLED=true
# debug | info | warn | error (JSON lines on stdout)
LOG_LEVEL=info

# ─── Demo ──────────────────────────────────────────────────────────────────
# Seed the fictional demo organisation (contacts + history) on first start.
SEED_DEMO_DATA=true
# Offer "Continue with demo" on the sign-in page (shared account, demo org only).
DEMO_LOGIN_ENABLED=false
# Allow an administrator of the demo organisation to reset its incidents.
DEMO_RESET_ENABLED=false

PUBLIC_APP_NAME=SENTINEL
