{
	"name": "sentinel",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "npm run build && node scripts/e2e-inprocess.mjs --voice-mock",
		"start": "node --env-file-if-exists=.env build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/db.ts migrate",
		"db:seed": "tsx --env-file-if-exists=.env scripts/db.ts seed",
		"db:reset": "tsx --env-file-if-exists=.env scripts/db.ts reset",
		"test:all": "npm run check && npm test && npm run test:e2e",
		"test:live": "npm run build && node --env-file=.env scripts/live-voice.mjs",
		"test:live:browser": "npm run build && node --env-file=.env scripts/live-browser.mjs",
		"test:live:resume": "npm run build && node --env-file=.env scripts/live-resume.mjs"
	},
	"devDependencies": {
		"@electric-sql/pglite-socket": "^0.2.11",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"ws": "^8.21.3"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@lucide/svelte": "^1.48.0",
		"drizzle-orm": "^0.45.3",
		"pg": "^8.23.0",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": ">=20.6"
	}
}
